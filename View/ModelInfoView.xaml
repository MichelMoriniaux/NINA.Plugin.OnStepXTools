<UserControl x:Class="NINA.Plugin.OnStepXTools.View.ModelInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Coefficients -->
            <RowDefinition Height="*"/>    <!-- Plots -->
        </Grid.RowDefinitions>

        <!-- ── Pointing model coefficients (top) ─────────────────────────────── -->
        <GroupBox Grid.Row="0" Header="Pointing Model Coefficients"
                  Foreground="{DynamicResource PrimaryBrush}" Margin="4,4,4,2">
            <StackPanel Margin="4,2">
                <!-- Values in two compact rows of 6 -->
                <UniformGrid Rows="2" Columns="6">
                    <StackPanel Margin="4,1" ToolTip="ax1Cor - HA (RA) axis zero-point error in arcseconds. Corrects a constant offset in the mount's hour-angle reading.">
                        <TextBlock Text="ax1Cor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Ax1Cor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="ax2Cor - Dec axis zero-point error in arcseconds. Sign reverses with pier flip on a GEM. Corrects encoder calibration offset.">
                        <TextBlock Text="ax2Cor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Ax2Cor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="altCor - Polar axis elevation error in arcseconds. Positive = polar axis pointing too high (above the pole).">
                        <TextBlock Text="altCor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.AltCor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="azmCor - Polar axis azimuth error in arcseconds. Positive = polar axis pointing too far East.">
                        <TextBlock Text="azmCor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.AzmCor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="doCor - Optical axis non-perpendicularity to the Dec axis (collimation error) in arcseconds. Causes an HA offset that scales with sec(Dec).">
                        <TextBlock Text="doCor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.DoCor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="dfCor - Dec axis flexure in arcseconds. Gravity-induced sag of the Dec axis; latitude-dependent GEM formula.">
                        <TextBlock Text="dfCor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.DfCor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Margin="4,1" ToolTip="tfCor - Tube (optical) flexure in arcseconds. Gravity-induced sag of the OTA; depends on latitude and pointing direction.">
                        <TextBlock Text="tfCor" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.TfCor, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="hca - HA harmonic amplitude in arcseconds. Peak amplitude of the periodic error in the HA axis.">
                        <TextBlock Text="hca" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Hca, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="hcp - HA harmonic phase in degrees. Angle at which the HA periodic error peaks.">
                        <TextBlock Text="hcp" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Hcp, StringFormat='{}{0:F4}°'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="dca - Dec harmonic amplitude in arcseconds. Peak amplitude of the periodic error in the Dec axis.">
                        <TextBlock Text="dca" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Dca, StringFormat='{}{0:F4}&quot;'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="dcp - Dec harmonic phase in degrees. Angle at which the Dec periodic error peaks.">
                        <TextBlock Text="dcp" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Dcp, StringFormat='{}{0:F4}°'}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Margin="4,1" ToolTip="Number of plate-solved stars used in the model fit. At least 6 required; 30+ recommended for reliable polar alignment parameters.">
                        <TextBlock Text="stars" Foreground="Gray" FontSize="9"/>
                        <TextBlock Text="{Binding Coefficients.Stars}"
                                   FontFamily="Courier New" FontSize="11"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Error-arrow scale slider -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <TextBlock Text="Arrow scale:" VerticalAlignment="Center" Foreground="Gray"
                               FontSize="11" Margin="0,0,6,0"/>
                    <Slider Width="120" Minimum="0.5" Maximum="20" SmallChange="0.5" LargeChange="2"
                            Value="{Binding ErrorArrowScale}"
                            VerticalAlignment="Center"
                            ToolTip="Multiply the auto-scaled residual arrow lengths - drag right to make arrows longer"/>
                    <TextBlock Text="{Binding ErrorArrowScale, StringFormat='  ×{0:F1}'}"
                               VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                </StackPanel>

                <!-- Action buttons + status -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Write to Mount"  Command="{Binding WriteToMountCommand}"         Padding="6,2" Margin="0,0,6,0"
                            ToolTip="Upload coefficients to controller RAM (:SX0n,v#) - active immediately but lost on power cycle"/>
                    <Button Content="Write to Mount + Save to EEPROM"
                            Command="{Binding WriteToEepromCommand}"
                            Padding="6,2" Margin="0,0,6,0"
                            ToolTip="Upload coefficients (:SX0n,v#) then persist to non-volatile memory (:AW#) - survives power cycles"/>
                    <Button Content="Save Model…"     Command="{Binding SaveModelCommand}"            Padding="6,2" Margin="0,0,6,0"
                            ToolTip="Export the current coefficients to a JSON file (can be shared or re-applied later with the 'Apply Model from File' sequencer item)"/>
                    <Button Content="Load Model…"     Command="{Binding LoadModelCommand}"            Padding="6,2" Margin="0,0,6,0"
                            ToolTip="Import coefficients from a JSON file - the plots update to show the loaded model"/>
                    <Button Content="Force Model Activation"
                            Command="{Binding ForceModelActivationCommand}"
                            Padding="6,2" Margin="0,0,10,0"
                            ToolTip="Send :SX09,2# - force the controller to apply the loaded pointing model"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── Plots row ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="4,2,4,4">
            <Grid.ColumnDefinitions>
                <!-- Polar display: square via Viewbox -->
                <ColumnDefinition Width="*"/>
                <!-- Residual + Alt/Err stacked -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Polar sky chart - forced square by Viewbox with equal logical dimensions -->
            <Viewbox Grid.Column="0" Stretch="Uniform"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,4,0"
                     ToolTip="Azimuthal equidistant polar projection. Green = pending, yellow = in progress, red = solved, dark-red = failed. Yellow arrows show pointing errors (scale controlled by the slider above). White bullseye = live mount position.">
                <oxy:PlotView Width="500" Height="500"
                              Model="{Binding SkyPlot}" Background="#0a0a1e"/>
            </Viewbox>

            <!-- Residual scatter -->
            <oxy:PlotView Grid.Column="1" Margin="4,0,0,0"
                          Model="{Binding ResidualPlot}" Background="#0a0a1e"
                          ToolTip="ΔRA vs ΔDec residual scatter plot. Each point is one plate-solved star. The dashed circle shows the RMS error. A tight cluster near the origin indicates a good fit."/>
        </Grid>

    </Grid>
</UserControl>
