<UserControl x:Class="NINA.Plugin.OnStepXTools.View.PointGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:model="clr-namespace:NINA.Plugin.OnStepXTools.Model"
             xmlns:conv="clr-namespace:NINA.Plugin.OnStepXTools.Converters"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left column ───────────────────────────────────────────────────── -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>      <!-- scrollable controls -->
                <RowDefinition Height="282"/>    <!-- residuals chart — height = column(290) − margin(8) → square -->
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Mode -->
                    <TextBlock Text="Mode:" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox SelectedValue="{Binding SelectedMode}" SelectedValuePath="Tag" Margin="0,0,0,8"
                              ToolTip="Full-Sky Pointing Model: fits 11 parameters (up to 300 stars). Star Alignment: on-device solve (max 9 stars).">
                        <ComboBoxItem Tag="{x:Static model:BuildMode.FullSkyPointingModel}">Full-Sky Pointing Model  (max 300)</ComboBoxItem>
                        <ComboBoxItem Tag="{x:Static model:BuildMode.StarAlignment}">Star Alignment  (max 9)</ComboBoxItem>
                    </ComboBox>

                    <!-- Meridian exclusion zone -->
                    <TextBlock Text="Meridian Exclusion Zone:" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2"
                               ToolTip="Points within this angular distance of the meridian (N and S) are excluded. Pre-filled from N.I.N.A.'s meridian flip setting."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="55"
                                 Text="{Binding MeridianExclusionDeg, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Half-width of the exclusion zone in degrees of hour angle (0 = no exclusion)"/>
                        <TextBlock Text=" °" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Point count -->
                    <TextBlock Text="Desired Point Count:" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2"
                               ToolTip="Number of sky positions to observe. More points improve model accuracy. Minimum 6 for the pointing model solver."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Slider Width="180" Minimum="1" Maximum="{Binding MaxPointCount}"
                                Value="{Binding Options.PointCount}" VerticalAlignment="Center"
                                TickFrequency="{Binding TickFrequency}"
                                ToolTip="Drag to set the number of points (1 – maximum for the selected mode)"/>
                        <TextBox Width="50" Margin="4,0,0,0"
                                 Text="{Binding Options.PointCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter the exact point count directly"/>
                        <TextBlock Text="{Binding MaxPointCount, StringFormat=' /{0}'}"
                                   VerticalAlignment="Center" Foreground="Gray" FontSize="10"
                                   ToolTip="Maximum points allowed by the selected mode"/>
                    </StackPanel>

                    <!-- Algorithm -->
                    <TextBlock Text="Algorithm:" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox SelectedValue="{Binding SelectedMethod}" SelectedValuePath="Tag" Margin="0,0,0,6"
                              ToolTip="Point distribution algorithm. Golden Spiral gives uniform sky coverage. Sidereal Path follows a DSO's track. Auto Grid uses an equal-area grid. Random uses seeded uniform sampling.">
                        <ComboBoxItem Tag="{x:Static model:GenerationMethod.GoldenSpiral}"
                                      ToolTip="Fibonacci lattice - uniform area density across the altitude band. Best general-purpose choice.">Golden Spiral</ComboBoxItem>
                        <ComboBoxItem Tag="{x:Static model:GenerationMethod.SiderealPath}"
                                      ToolTip="Sweeps a configurable HA range at a target declination ± step. Good for single-night observing runs.">Sidereal Path</ComboBoxItem>
                        <ComboBoxItem Tag="{x:Static model:GenerationMethod.AutoGrid}"
                                      ToolTip="Equal-area altitude/azimuth grid - point density weighted by cos(altitude) so sky coverage is uniform.">Auto Grid</ComboBoxItem>
                        <ComboBoxItem Tag="{x:Static model:GenerationMethod.Random}"
                                      ToolTip="Uniform random on the sphere sector - reproducible with the configured seed.">Random</ComboBoxItem>
                    </ComboBox>

                    <!-- SiderealPath options -->
                    <Border Visibility="{Binding IsSiderealPath, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Sidereal Path Parameters" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Target Dec:" Width="80" VerticalAlignment="Center"
                                           ToolTip="Centre declination of the path - three Dec bands are generated around this value"/>
                                <TextBox Width="55"
                                         Text="{Binding Options.SiderealPathTargetDeclinationDeg, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Target declination in degrees (−90 to +90)."/>
                                <TextBlock Text=" °" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Dec step ±:" Width="80" VerticalAlignment="Center"
                                           ToolTip="Three declination bands are generated: target − step, target, target + step"/>
                                <TextBox Width="55"
                                         Text="{Binding Options.SiderealPathDecStepDeg, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Declination offset for the two outer bands in degrees"/>
                                <TextBlock Text=" °" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Options.SiderealPathDecStepDeg,
                                              StringFormat='  → three bands: target−{0:F0}°  target  target+{0:F0}°'}"
                                       Foreground="Gray" FontSize="10" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Start HA:" Width="80" VerticalAlignment="Center"
                                           ToolTip="Hour angle at which the path begins. Negative = East of meridian."/>
                                <TextBox Width="55"
                                         Text="{Binding Options.SiderealPathStartHours, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Start of HA sweep in hours. −6 = 6 hours East of meridian."/>
                                <TextBlock Text=" h  (−=East)" VerticalAlignment="Center" Foreground="Gray" FontSize="10" Margin="2,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="End HA:" Width="80" VerticalAlignment="Center"
                                           ToolTip="Hour angle at which the path ends. Positive = West of meridian."/>
                                <TextBox Width="55"
                                         Text="{Binding Options.SiderealPathEndHours, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="End of HA sweep in hours. +6 = 6 hours West of meridian."/>
                                <TextBlock Text=" h  (+=West)" VerticalAlignment="Center" Foreground="Gray" FontSize="10" Margin="2,0,0,0"/>
                            </StackPanel>
                            <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Altitude is determined by HA/Dec geometry. Only the custom horizon filter applies."/>
                        </StackPanel>
                    </Border>

                    <!-- Altitude range -->
                    <StackPanel Visibility="{Binding IsSiderealPath, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="Altitude Range:" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2"
                                   ToolTip="Points outside this altitude band are discarded."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Min:" VerticalAlignment="Center" ToolTip="Minimum altitude in degrees"/>
                            <TextBox Width="50" Margin="4,0,6,0"
                                     Text="{Binding Options.MinAltitudeDeg, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Minimum altitude for generated points (degrees)"/>
                            <TextBlock Text="°  Max:" VerticalAlignment="Center"/>
                            <TextBox Width="50" Margin="4,0,0,0"
                                     Text="{Binding Options.MaxAltitudeDeg, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Maximum altitude for generated points (degrees)"/>
                            <TextBlock Text="°" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Generate -->
                    <Button Content="▶  Generate Points" Command="{Binding GenerateCommand}"
                            Padding="8,4" FontWeight="Bold" Margin="0,4,0,8"
                            ToolTip="Generate the point list, apply horizon and meridian filters, and optimise slew order"/>

                    <!-- Result count + Save/Load -->
                    <TextBlock Text="{Binding Points.Count, StringFormat='{}{0} points generated'}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               ToolTip="Number of points after filtering."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save…" Command="{Binding SavePointsCommand}" Width="80" Margin="0,0,6,0"
                                ToolTip="Export the current point list to a JSON file"/>
                        <Button Content="Load…" Command="{Binding LoadPointsCommand}" Width="80"
                                ToolTip="Import a point list from a JSON file"/>
                    </StackPanel>

                    <!-- ═══ Build settings + Start / Cancel ═══════════════════════════ -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Build Settings" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Exposure:" Width="70" VerticalAlignment="Center"
                                           ToolTip="Capture duration per pointing star (seconds)"/>
                                <TextBox Width="50"
                                         Text="{Binding ExposureTimeSec, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Image exposure time in seconds for each plate solve"/>
                                <TextBlock Text=" s" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBlock Text="Settle:" Width="70" VerticalAlignment="Center"
                                           ToolTip="Wait time after each slew before capturing (seconds)"/>
                                <TextBox Width="50"
                                         Text="{Binding SettleTimeSec, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Slew settle time in seconds"/>
                                <TextBlock Text=" s" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶  Start Build" Command="{Binding StartBuildCommand}"
                                        Padding="8,4" FontWeight="Bold" Margin="0,0,6,0"
                                        Visibility="{Binding IsNotBuilding, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Slew to each point, plate-solve, and build the pointing model using the generated point list"/>
                                <Button Content="■  Cancel" Command="{Binding CancelBuildCommand}"
                                        Padding="8,4" FontWeight="Bold" Margin="0,0,0,0"
                                        Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Abort the running build after the current point completes"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Model coefficients ════════════════════════════════════════ -->
                    <Border Visibility="{Binding HasModel, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Pointing Model Coefficients" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"
                                       ToolTip="12-parameter OnStepX pointing model. All values in arcseconds except hcp/dcp which are in degrees."/>

                            <!-- 2×6 coefficient table -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="ax1:" Width="28" Foreground="Gray" FontSize="11" ToolTip="HA index error (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.Ax1Cor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                    <TextBlock Text="ax2:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Dec index error (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.Ax2Cor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>

                                <!-- Row 1 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="alt:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Polar altitude error (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.AltCor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                    <TextBlock Text="azm:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Polar azimuth error (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.AzmCor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>

                                <!-- Row 2 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="do:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Dec/HA orthogonality (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.DoCor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                    <TextBlock Text="pd:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Polar Dec misalignment (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.PdCor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>

                                <!-- Row 3 -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="df:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Dec flexure (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.DfCor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                    <TextBlock Text="tf:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Tube/fork flexure (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.TfCor, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>

                                <!-- Row 4 -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="hcp:" Width="28" Foreground="Gray" FontSize="11" ToolTip="HA cosine phase (degrees)"/>
                                    <TextBlock Text="{Binding Coefficients.Hcp, StringFormat='{}{0:F2}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="°" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                    <TextBlock Text="hca:" Width="28" Foreground="Gray" FontSize="11" ToolTip="HA cosine amplitude (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.Hca, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>

                                <!-- Row 5 -->
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="dcp:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Dec cosine phase (degrees)"/>
                                    <TextBlock Text="{Binding Coefficients.Dcp, StringFormat='{}{0:F2}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="°" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                    <TextBlock Text="dca:" Width="28" Foreground="Gray" FontSize="11" ToolTip="Dec cosine amplitude (arcseconds)"/>
                                    <TextBlock Text="{Binding Coefficients.Dca, StringFormat='{}{0:F1}'}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="&quot;" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Coefficients.Stars, StringFormat='From {0} stars'}"
                                       FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                       ToolTip="Number of alignment stars used to compute this model"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Arrow scale + model actions ══════════════════════════════ -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- Arrow scale slider -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Arrow scale:" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,4,0"
                                           ToolTip="Multiply the auto-scaled residual arrow lengths on the sky chart"/>
                                <Slider Width="110" Minimum="0.5" Maximum="20" SmallChange="0.5" LargeChange="2"
                                        Value="{Binding ErrorArrowScale}" VerticalAlignment="Center"
                                        ToolTip="Drag right to lengthen residual error arrows"/>
                                <TextBlock Text="{Binding ErrorArrowScale, StringFormat=' ×{0:F1}'}"
                                           VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                            </StackPanel>

                            <!-- Model action buttons row 1 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Write to Mount" Command="{Binding WriteToMountCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Upload the loaded pointing model coefficients to the mount controller"/>
                                <Button Content="Save to EEPROM" Command="{Binding WriteToEepromCommand}"
                                        Padding="4,3" FontSize="11"
                                        ToolTip="Write coefficients to the mount and persist them to EEPROM (:AW#)"/>
                            </StackPanel>

                            <!-- Model action buttons row 2 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Save Model…" Command="{Binding SaveModelCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Save the current model coefficients to a JSON file"/>
                                <Button Content="Load Model…" Command="{Binding LoadModelCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Load model coefficients from a JSON file"/>
                                <Button Content="Force Activate" Command="{Binding ForceActivationCommand}"
                                        Padding="4,3" FontSize="11"
                                        ToolTip="Force the mount to activate the current model (:SX09,2#)"/>
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Text="{Binding BuildStatusMessage}" FontSize="10"
                                       Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Legend ════════════════════════════════════════════════════ -->
                    <Border Margin="0,10,0,4" Padding="4" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="Chart legend:" Foreground="Gray" FontSize="10" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Rectangle Width="12" Height="4" Fill="CornflowerBlue" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="Meridian exclusion zone" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Rectangle Width="12" Height="4" Fill="SlateGray" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="Custom horizon (below = excluded)" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Ellipse Width="8" Height="8" Fill="Cyan" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Planned / pending" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Ellipse Width="8" Height="8" Fill="LimeGreen" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Visited &amp; solved" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Ellipse Width="8" Height="8" Fill="Yellow" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="In progress" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Ellipse Width="8" Height="8" Fill="Red" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Failed" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Rectangle Width="12" Height="2" Fill="Yellow" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Residual error arrow" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Residuals chart pinned to the bottom of the left column -->
            <oxy:PlotView Grid.Row="1" Model="{Binding ResidualPlot}" Background="#0a0a1e"
                          ToolTip="Residuals scatter plot — ΔRA vs ΔDec for all solved points. The dashed circle shows the RMS error radius."/>
        </Grid>

        <!-- ── Sky chart ─────────────────────────────────────────────────────── -->
        <!-- SizeChanged fires RefreshSkyPlot() which pushes a new PlotModel into the
             PlotView, forcing OxyPlot to re-render at the current container size.
             Without this, OxyPlot caches its canvas dimensions and the chart only
             shrinks — it never expands when the window grows. -->
        <Grid Grid.Column="1" SizeChanged="SkyContainer_SizeChanged">
            <oxy:PlotView Model="{Binding SkyPlot}" Background="#0a0a1e"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          MinWidth="0" MinHeight="0"
                          ToolTip="Azimuthal sky projection (North top). Cyan = planned, Green = solved, Yellow = in progress, Red = failed. Yellow arrows show residual errors."/>
        </Grid>
    </Grid>
</UserControl>
