<UserControl x:Class="NINA.Plugin.OnStepXTools.View.MountSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:NINA.Plugin.OnStepXTools.Model"
             xmlns:conv="clr-namespace:NINA.Plugin.OnStepXTools.Converters"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter  x:Key="InvBoolToVis" Invert="True"/>
        <conv:BoolStringConverter        x:Key="BoolStringConverter"/>
        <conv:ZeroToVisibilityConverter  x:Key="ZeroToVis"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource ButtonForegroundBrush}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!-- ── Toolbar (full width) ──────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="↻  Read All Settings" Command="{Binding LoadCommand}"
                        Padding="8,3" FontWeight="Bold"
                        ToolTip="Re-read all mount settings from the controller via LX200 commands (:GU#, :%BR#, :Gh#, etc.)"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>

            <!-- ── Two-column body ───────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══ LEFT COLUMN — operational settings ════════════════════════ -->
                <StackPanel Grid.Column="0" Margin="0,0,4,0">

                    <!-- Site Location -->
                    <GroupBox Header="Site Location" Margin="0,0,0,4">
                        <StackPanel Margin="6,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Sync Site from N.I.N.A."
                                        Command="{Binding SyncSiteFromNinaCommand}"
                                        Padding="8,3"
                                        ToolTip="Upload latitude and longitude from N.I.N.A.'s configured site (Options → Astrometry) to the mount (:St# :Sg#)"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Lat:" Width="28" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LatitudeDMS}" FontFamily="Courier New" Margin="2,0,10,0"
                                           VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="Lon:" Width="28" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LongitudeDMS}" FontFamily="Courier New" Margin="2,0,0,0"
                                           VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tracking -->
                    <GroupBox Header="Tracking" Margin="0,0,0,4"
                              ToolTip="Tracking state, rate and frequency fine-tune">
                        <StackPanel Margin="6,4">

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="State:" Width="90" VerticalAlignment="Center"/>
                                <Button Content="ON"  Command="{Binding TrackOnCommand}"  Width="50" Margin="0,0,4,0"
                                        ToolTip="Enable sky tracking (:Te#)" Background="#1a3a1a"/>
                                <Button Content="OFF" Command="{Binding TrackOffCommand}" Width="50"
                                        ToolTip="Disable sky tracking (:Td#)" Background="#3a1a1a"/>
                                <TextBlock Text="{Binding TrackingEnabled, StringFormat='  {0}'}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Rate:" Width="90" VerticalAlignment="Center"
                                           ToolTip="Sidereal = stars, Lunar = Moon, Solar = Sun, King = refraction-corrected sidereal"/>
                                <ComboBox Width="110" SelectedValue="{Binding TrackingRate}" SelectedValuePath="Tag" Margin="0,0,6,0"
                                          ToolTip="Sidereal (15.04°/h), Lunar (14.51°/h), Solar (15.00°/h), King (refraction-corrected)">
                                    <ComboBoxItem Tag="{x:Static model:TrackingRate.Sidereal}">Sidereal</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:TrackingRate.Lunar}">Lunar</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:TrackingRate.Solar}">Solar</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:TrackingRate.King}">King</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Set" Command="{Binding SetTrackRateCommand}" Width="50"
                                        ToolTip="Apply the selected tracking rate (:TQ# / :TL# / :TS# / :TK#)"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Compensation:" Width="90" VerticalAlignment="Center"
                                           ToolTip="Atmospheric refraction or model compensation applied to the tracking rate"/>
                                <ComboBox Width="150" SelectedValue="{Binding CompensatedTracking}" SelectedValuePath="Tag" Margin="0,0,6,0"
                                          ToolTip="Off = no compensation. Refraction Only = corrects atmospheric bending. Full = refraction + model.">
                                    <ComboBoxItem Tag="{x:Static model:CompensatedTracking.Off}">Off</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:CompensatedTracking.RefractionOnly}">Refraction only</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:CompensatedTracking.Full}">Full model</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Set" Command="{Binding SetCompTrackCommand}" Width="50"
                                        ToolTip="Apply compensation mode (:Tn# / :T1# / :T2#)"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Axis:" Width="90" VerticalAlignment="Center"
                                           ToolTip="Atmospheric refraction compensation applied to axis"/>
                                <ComboBox Width="150" SelectedValue="{Binding CompensatedTrackingAxis}" SelectedValuePath="Tag" Margin="0,0,6,0"
                                          ToolTip="Single = applies only to RA. Dual = applies to RA and DEC.">
                                    <ComboBoxItem Tag="{x:Static model:CompensatedTrackingAxis.Single}">Single</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:CompensatedTrackingAxis.Dual}">Dual</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Set" Command="{Binding SetCompTrackCommand}" Width="50"
                                        ToolTip="Apply compensation mode (:Tn# / :T1# / :T2#)"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Freq. Adjust:" Width="90" VerticalAlignment="Center"
                                           ToolTip="Fine-tune base tracking frequency by ±0.02 Hz"/>
                                <Button Content="+0.02 Hz" Command="{Binding FreqPlusCommand}"  Width="72" Margin="0,0,4,0"
                                        ToolTip="Increase tracking frequency by 0.02 Hz (:T+#)"/>
                                <Button Content="−0.02 Hz" Command="{Binding FreqMinusCommand}" Width="72" Margin="0,0,4,0"
                                        ToolTip="Decrease tracking frequency by 0.02 Hz (:T-#)"/>
                                <Button Content="Reset"    Command="{Binding FreqResetCommand}" Width="50"
                                        ToolTip="Reset to default tracking frequency (:TR#)"/>
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>

                    <!-- Guide Rate & Slew Speed -->
                    <GroupBox Header="Guide Rate &amp; Slew Speed" Margin="0,0,0,4"
                              ToolTip="Guide rate used by the guider, and maximum slew speed for goto operations">
                        <StackPanel Margin="6,4">

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Guide Rate:" Width="90" VerticalAlignment="Center"
                                           ToolTip="Pulse-guide rate as a fraction of sidereal"/>
                                <ComboBox Width="90" SelectedIndex="{Binding GuideRateIndex}" Margin="0,0,6,0"
                                          ItemsSource="{x:Static local:MountSettingsViewModel.GuideRateNames}"
                                          xmlns:local="clr-namespace:NINA.Plugin.OnStepXTools.ViewModels"
                                          ToolTip="Index 2 (1×) = sidereal guide rate, suitable for most setups"/>
                                <Button Content="Set" Command="{Binding SetGuideRateCommand}" Width="50"
                                        ToolTip="Apply the selected guide rate (:R0# through :R9#)"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Slew Speed:" Width="90" VerticalAlignment="Center"
                                           ToolTip="Maximum speed for goto slews"/>
                                <ComboBox Width="90" SelectedValue="{Binding SlewSpeed}" SelectedValuePath="Tag" Margin="0,0,6,0"
                                          ToolTip="V.Fast = fastest possible slew. V.Slow = most accurate for short moves.">
                                    <ComboBoxItem Tag="{x:Static model:SlewSpeed.VFast}">V.Fast</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:SlewSpeed.Fast}">Fast</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:SlewSpeed.Normal}">Normal</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:SlewSpeed.Slow}">Slow</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:SlewSpeed.VSlow}">V.Slow</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Set" Command="{Binding SetSlewSpeedCommand}" Width="50"
                                        ToolTip="Apply the selected slew speed (:RS0# through :RS4#)"/>
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>

                    <!-- Meridian Flip & Park -->
                    <GroupBox Header="Meridian Flip &amp; Park" Margin="0,0,0,4"
                              ToolTip="GEM meridian flip behaviour and park position settings">
                        <StackPanel Margin="6,4">

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Auto flip at limit:" Width="160" VerticalAlignment="Center"
                                           ToolTip="Automatically flip to the other pier side at the meridian limit (:SXE6,n#)"/>
                                <CheckBox IsChecked="{Binding AutoMeridianFlip}" VerticalAlignment="Center"
                                          ToolTip="Enable automatic meridian flip"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Pause at home:" Width="160" VerticalAlignment="Center"
                                           ToolTip="Pause at home switch during meridian flip (:SXE7,n#)"/>
                                <CheckBox IsChecked="{Binding PauseAtHome}" VerticalAlignment="Center"
                                          ToolTip="Pause at home index position before continuing"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Goto buzzer:" Width="160" VerticalAlignment="Center"
                                           ToolTip="Play a beep when a goto slew completes (:SXE5,n#)"/>
                                <CheckBox IsChecked="{Binding BuzzerEnabled}" VerticalAlignment="Center"
                                          ToolTip="Enable the audible alert at end of goto"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Preferred pier side:" Width="160" VerticalAlignment="Center"
                                           ToolTip="Which pier side to prefer after a meridian flip (:SXE8,n#)"/>
                                <ComboBox Width="80" SelectedValue="{Binding PreferredPierSide}" SelectedValuePath="Tag"
                                          ToolTip="Best = firmware decides. East/West = always flip to that side.">
                                    <ComboBoxItem Tag="{x:Static model:PreferredPierSide.Best}">Best</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:PreferredPierSide.West}">West</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:PreferredPierSide.East}">East</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:PreferredPierSide.Auto}">Auto</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Apply Settings"
                                        Command="{Binding SetMeridianSettingsCommand}"
                                        Padding="6,3" Margin="0,0,6,0"
                                        ToolTip="Write all four meridian/buzzer settings to the mount"/>
                                <Button Content="Trigger Flip Now"
                                        Command="{Binding TriggerMeridianFlipCommand}"
                                        Padding="6,3" Margin="0,0,6,0"
                                        ToolTip="Force a meridian flip immediately — mount slews to the opposite pier side (:Mf#)"/>
                                <Button Content="Set Park Position"
                                        Command="{Binding SetParkCommand}"
                                        Padding="6,3" Margin="0,0,6,0"
                                        ToolTip="Save the current mount position as the park position (:hQ#)"/>
                                <Button Content="Set Home Position"
                                        Command="{Binding SetHomeCommand}"
                                        Padding="6,3"
                                        ToolTip="Save the current mount position as the home position (:FH#)"/>
                            </WrapPanel>

                        </StackPanel>
                    </GroupBox>

                    <!-- Model Management -->
                    <GroupBox Header="Sky Model Management" Margin="0,0,0,4"
                              ToolTip="Tools to manage the currently loaded model">
                        <StackPanel Margin="6,4">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Clear Model" Command="{Binding ClearModelCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Resets all the model values to 0.0, functionaly clearing the model"/>
                                <Button Content="Clear Model from EEPROM" Command="{Binding ClearModelfromEepromCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Writes 0.0 values to the EEPROM, the mount will load an empty model at next boot"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Get Model from mount" Command="{Binding LoadModelFromMountCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Load model coefficients stored on the mount"/>
                                <Button Content="Load Model from file…" Command="{Binding LoadModelCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Load model coefficients from a JSON file"/>
                            </StackPanel>

                    <!-- ═══ Model coefficients ════════════════════════════════════════ -->
                            <Border
                                    BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Pointing Model Coefficients" FontWeight="Bold" FontSize="11"
                                            Margin="0,0,0,6"
                                            ToolTip="12-parameter OnStepX pointing model. All values in arcseconds except hcp/dcp which are in degrees."/>

                                    <!-- 2×6 coefficient table -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="ax1:" Width="28" FontSize="11" ToolTip="HA index error (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.Ax1Cor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                            <TextBlock Text="ax2:" Width="28" FontSize="11" ToolTip="Dec index error (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.Ax2Cor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Row 1 -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="alt:" Width="28" FontSize="11" ToolTip="Polar altitude error (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.AltCor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                            <TextBlock Text="azm:" Width="28" FontSize="11" ToolTip="Polar azimuth error (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.AzmCor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Row 2 -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="do:" Width="28" FontSize="11" ToolTip="Dec/HA orthogonality (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.DoCor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                            <TextBlock Text="pd:" Width="28" FontSize="11" ToolTip="Polar Dec misalignment (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.PdCor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Row 3 -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="df:" Width="28" FontSize="11" ToolTip="Dec flexure (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.DfCor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                            <TextBlock Text="tf:" Width="28" FontSize="11" ToolTip="Tube/fork flexure (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.TfCor, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Row 4 -->
                                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="hcp:" Width="28" FontSize="11" ToolTip="HA cosine phase (degrees)"/>
                                            <TextBlock Text="{Binding Coefficients.Hcp, StringFormat='{}{0:F2}'}" FontSize="11"/>
                                            <TextBlock Text="°" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                            <TextBlock Text="hca:" Width="28" FontSize="11" ToolTip="HA cosine amplitude (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.Hca, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Row 5 -->
                                        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="dcp:" Width="28" FontSize="11" ToolTip="Dec cosine phase (degrees)"/>
                                            <TextBlock Text="{Binding Coefficients.Dcp, StringFormat='{}{0:F2}'}" FontSize="11"/>
                                            <TextBlock Text="°" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="4,2,0,2">
                                            <TextBlock Text="dca:" Width="28" FontSize="11" ToolTip="Dec cosine amplitude (arcseconds)"/>
                                            <TextBlock Text="{Binding Coefficients.Dca, StringFormat='{}{0:F1}'}" FontSize="11"/>
                                            <TextBlock Text="&quot;" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Coefficients.Stars, StringFormat='From {0} stars'}"
                                            FontSize="10" Margin="0,4,0,0"
                                            ToolTip="Number of alignment stars used to compute this model"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Write to Mount" Command="{Binding WriteToMountCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Upload the loaded pointing model coefficients to the mount controller"/>
                                <Button Content="Push to EEPROM" Command="{Binding WriteToEepromCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Write coefficients to the mount and persist them to EEPROM (:AW#)"/>
                                <Button Content="Force Activate" Command="{Binding ForceActivationCommand}"
                                        Padding="4,3" FontSize="11"
                                        ToolTip="Force the mount to activate the current model (:SX09,2#)"/>
                            </StackPanel>

                            <!-- Model file actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Save Model to File…" Command="{Binding SaveModelCommand}"
                                        Padding="4,3" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="Save the current model coefficients to a JSON file"/>
                            </StackPanel>

                        </StackPanel>

                    </GroupBox>

                </StackPanel>

                <!-- ══ RIGHT COLUMN — hardware / axis settings ════════════════════ -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0">

                    <!-- Backlash -->
                    <GroupBox Header="Backlash (arcseconds)" Margin="0,0,0,4"
                              ToolTip="Gear backlash compensation during direction reversals. 0 = disabled.">
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Axis 1 — RA / Az:" Margin="0,2,8,2" VerticalAlignment="Center"
                                       ToolTip="Backlash on the RA/Azimuth axis (read via :%BR#)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding BacklashAxis1Arcsec, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                       ToolTip="Backlash in arcseconds (0–3600)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Axis 2 — Dec / Alt:" Margin="0,2,8,2" VerticalAlignment="Center"
                                       ToolTip="Backlash on the Dec/Altitude axis (read via :%BD#)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding BacklashAxis2Arcsec, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                       ToolTip="Backlash in arcseconds (0–3600)"/>

                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                    Content="Set Backlash" Command="{Binding SetBacklashCommand}"
                                    HorizontalAlignment="Left" Padding="8,3" Margin="0,6,0,0"
                                    ToolTip="Write both backlash values to the mount (:$BRn# / :$BDn#)"/>
                        </Grid>
                    </GroupBox>

                    <!-- Limits -->
                    <GroupBox Header="Limits" Margin="0,0,0,4"
                              ToolTip="Movement limits that prevent the mount from pointing into unsafe zones">
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Min altitude (°):" Margin="0,2,8,2" VerticalAlignment="Center"
                                       ToolTip="Minimum altitude for goto commands (:Gh# / :Sh#)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding LimitMinAltDeg, StringFormat='{}{0:F0}', UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                       ToolTip="Minimum altitude in degrees (−30 to +30)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Max altitude (°):" Margin="0,2,8,2" VerticalAlignment="Center"
                                       ToolTip="Maximum altitude for goto commands (:Go# / :So#)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding LimitMaxAltDeg, StringFormat='{}{0:F0}', UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                       ToolTip="Maximum altitude in degrees (60–90)"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Past meridian East (°):" Margin="0,6,8,2" VerticalAlignment="Center" FontSize="11"
                                       ToolTip="How far East of meridian the mount may track before a flip is required (:GXE9#)"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding LimitEastPastMeridian, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,2"
                                       ToolTip="Degrees East past meridian (0–270°)"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Past meridian West (°):" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11"
                                       ToolTip="How far West of meridian the mount may track before stopping (:GXEA#)"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding LimitWestPastMeridian, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                       ToolTip="Degrees West past meridian (0–270°)"/>

                            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                    Content="Set All Limits" Command="{Binding SetLimitsCommand}"
                                    HorizontalAlignment="Left" Padding="8,3" Margin="0,6,0,0"
                                    ToolTip="Write all four limit values to the mount (:Sh# :So# :SXE9# :SXEA#)"/>
                        </Grid>
                    </GroupBox>

                    <!-- Mount Type & Controller -->
                    <GroupBox Header="Mount Type &amp; Controller" Margin="0,0,0,4"
                              ToolTip="Mount geometry and controller reset">
                        <StackPanel Margin="6,4">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Mount type:" Width="90" VerticalAlignment="Center"
                                           ToolTip="GEM=0, EQ Fork=1, Alt/Az=2. Reboot required after change."/>
                                <ComboBox Width="100" SelectedValue="{Binding MountType}" SelectedValuePath="Tag" Margin="0,0,6,0"
                                          ToolTip="Select the mount geometry. Reboot required after changing.">
                                    <ComboBoxItem Tag="{x:Static model:MountType.GEM}">GEM</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:MountType.EQFork}">EQ Fork</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static model:MountType.AltAz}">Alt/Az</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Set" Command="{Binding SetMountTypeCommand}" Padding="6,2"
                                        ToolTip="Send :SXEM,n# — reboot required for change to take effect"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <Button Content="Reboot Controller" Command="{Binding RebootCommand}"
                                        Padding="6,2" Margin="0,0,8,0"
                                        ToolTip="Send :ERESET# — mount will disconnect and reconnect"/>
                                <TextBlock Text="⚠ Mount will disconnect" VerticalAlignment="Center"
                                           FontSize="10" Foreground="Orange"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Axis 1 -->
                    <GroupBox Margin="0,0,0,4">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Axis 1 — RA / Az   " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Axis1DriverId}" FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel Margin="4,2">
                            <ItemsControl ItemsSource="{Binding Axis1Params}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:AxisParameter}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding RangeHint, Mode=OneWay}" FontSize="10"/>
                                                <Run Text="{Binding ImmediateHint, Mode=OneWay}" FontSize="10"/>
                                            </TextBlock>
                                            <CheckBox Grid.Column="1"
                                                      Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" Margin="4,0"
                                                      IsChecked="{Binding EditValue, Converter={StaticResource BoolStringConverter}}"/>
                                            <TextBox Grid.Column="1"
                                                     Visibility="{Binding IsBoolean, Converter={StaticResource InvBoolToVis}}"
                                                     Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Courier New" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentValue, StringFormat='now: {0}'}"
                                                       VerticalAlignment="Center" FontSize="10" Margin="4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Visibility="{Binding Axis1Params.Count, Converter={StaticResource ZeroToVis}}"
                                       Text="No runtime-configurable parameters (:GXA returned 0)."
                                       FontStyle="Italic" FontSize="10" Margin="4,4" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <Button Content="Save Axis 1" Command="{Binding SaveAxis1Command}"
                                        Padding="6,3" Margin="0,0,8,0"
                                        ToolTip="Write changed Axis 1 parameters to the mount (:SXA1,n,v#)"/>
                                <Button Content="Revert Defaults" Command="{Binding RevertAxis1Command}"
                                        Padding="6,3"
                                        ToolTip="Reset Axis 1 parameters to firmware defaults (:SXA1,R#)"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Axis 2 -->
                    <GroupBox Margin="0,0,0,4">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Axis 2 — Dec / Alt   " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Axis2DriverId}" FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel Margin="4,2">
                            <ItemsControl ItemsSource="{Binding Axis2Params}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:AxisParameter}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding RangeHint, Mode=OneWay}" FontSize="10"/>
                                                <Run Text="{Binding ImmediateHint, Mode=OneWay}" FontSize="10"/>
                                            </TextBlock>
                                            <CheckBox Grid.Column="1"
                                                      Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" Margin="4,0"
                                                      IsChecked="{Binding EditValue, Converter={StaticResource BoolStringConverter}}"/>
                                            <TextBox Grid.Column="1"
                                                     Visibility="{Binding IsBoolean, Converter={StaticResource InvBoolToVis}}"
                                                     Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Courier New" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentValue, StringFormat='now: {0}'}"
                                                       VerticalAlignment="Center" FontSize="10" Margin="4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Visibility="{Binding Axis2Params.Count, Converter={StaticResource ZeroToVis}}"
                                       Text="No runtime-configurable parameters (:GXA returned 0)."
                                       FontStyle="Italic" FontSize="10" Margin="4,4" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <Button Content="Save Axis 2" Command="{Binding SaveAxis2Command}"
                                        Padding="6,3" Margin="0,0,8,0"
                                        ToolTip="Write changed Axis 2 parameters to the mount (:SXA2,n,v#)"/>
                                <Button Content="Revert Defaults" Command="{Binding RevertAxis2Command}"
                                        Padding="6,3"
                                        ToolTip="Reset Axis 2 parameters to firmware defaults (:SXA2,R#)"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Servo Calibration -->
                    <GroupBox Header="Servo Calibration  ⚠ Verify against firmware before use"
                              Margin="0,0,0,4"
                              ToolTip="These commands affect servo driver calibration in real time — use with caution">
                        <WrapPanel Margin="6,4">
                            <Button Content="Track Normally"     Command="{Binding ServoTrackNormalCommand}"  Margin="2" Padding="5,2"
                                    ToolTip="Resume normal sidereal tracking (:TOA#)"/>
                            <Button Content="Track Fixed Rate"   Command="{Binding ServoTrackFixedCommand}"   Margin="2" Padding="5,2"
                                    ToolTip="Switch to fixed-rate tracking for calibration (:TOF#)"/>
                            <Button Content="Record Calibration" Command="{Binding ServoRecordCommand}"       Margin="2" Padding="5,2"
                                    ToolTip="Start recording calibration data (:SXC1,1#)"/>
                            <Button Content="Stop Recording"     Command="{Binding ServoStopCommand}"         Margin="2" Padding="5,2"
                                    ToolTip="Stop calibration recording (:SXC1,0#)"/>
                            <Button Content="Clear Buffer"       Command="{Binding ServoClearCommand}"        Margin="2" Padding="5,2"
                                    ToolTip="Clear the calibration buffer (:SXC2,0#)"/>
                            <Button Content="Load Calibration"   Command="{Binding ServoLoadCalCommand}"      Margin="2" Padding="5,2"
                                    ToolTip="Load calibration from NVM (:SXC3,0#)"/>
                            <Button Content="Save Calibration"   Command="{Binding ServoSaveCalCommand}"      Margin="2" Padding="5,2"
                                    ToolTip="Save calibration to NVM (:SXC3,1#)"/>
                            <Button Content="Load Backup"        Command="{Binding ServoLoadBackupCommand}"   Margin="2" Padding="5,2"
                                    ToolTip="Restore calibration from backup (:SXC4,0#)"/>
                            <Button Content="Save Backup"        Command="{Binding ServoSaveBackupCommand}"   Margin="2" Padding="5,2"
                                    ToolTip="Save current calibration as backup (:SXC4,1#)"/>
                            <Button Content="High Pass Filter"   Command="{Binding ServoHpfCommand}"          Margin="2" Padding="5,2"
                                    ToolTip="Apply high-pass filter (:SXC5,1#)"/>
                            <Button Content="Low Pass Filter"    Command="{Binding ServoLpfCommand}"          Margin="2" Padding="5,2"
                                    ToolTip="Apply low-pass filter (:SXC5,0#)"/>
                        </WrapPanel>
                    </GroupBox>

                </StackPanel>
            </Grid>

            <!-- ── Status bar (full width) ───────────────────────────────────── -->
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,4,0,0" FontStyle="Italic" FontSize="11"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
