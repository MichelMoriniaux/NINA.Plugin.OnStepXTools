<ResourceDictionary x:Class="NINA.Plugin.OnStepXTools.Resources.SequenceTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:seq="clr-namespace:NINA.Plugin.OnStepXTools.SequenceItems"
                    xmlns:conv="clr-namespace:NINA.Plugin.OnStepXTools.Converters"
                    xmlns:view="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ── OnStepX Full-Sky Pointing Model ──────────────────────────────────── -->
    <DataTemplate DataType="{x:Type seq:BuildPointingModel}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6,4">

                    <!-- Options -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Write model to mount on completion"
                                  IsChecked="{Binding WriteToMount}" VerticalAlignment="Top"
                                  ToolTip="Upload the solved 11-parameter model coefficients to the controller via :SX0n,v# commands"/>
                        <TextBlock Grid.Column="1"
                                   Text="Upload solved pointing model coefficients to the mount"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,2,0,0" VerticalAlignment="Top" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Resume last session"
                                  IsChecked="{Binding ResumeLastSession}" VerticalAlignment="Top"
                                  ToolTip="Reload the most recent build session from disk and skip already-completed points"/>
                        <TextBlock Grid.Column="1"
                                   Text="Skip already-completed points from the previous interrupted run"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,2,0,0" VerticalAlignment="Top" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Save coefficients to file -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Save coefficients to file after build"
                                  IsChecked="{Binding SaveCoefficientsToFile}" VerticalAlignment="Top"
                                  ToolTip="Write the solved model coefficients to a JSON file when the build completes - the file can then be loaded in the Model Info panel"/>
                        <TextBlock Grid.Column="1"
                                   Text="Write solved coefficients to a .json file (loadable in Model Info View)"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,2,0,0" VerticalAlignment="Top" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- File path row - shown only when save is enabled -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8"
                                Visibility="{Binding ShowSavePath, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="340" Text="{Binding CoefficientsFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Path to write the coefficients JSON file"
                                 FontSize="11" FontFamily="Courier New"/>
                        <Button Content="Browse…" Command="{Binding BrowseSavePathCommand}"
                                Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Open a file picker to choose where to write the coefficient JSON file"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,8"/>

                    <!-- Point source -->
                    <TextBlock Text="Point list source:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Load from file…"
                                Command="{Binding LoadPointsCommand}" Padding="8,2"
                                ToolTip="Load a previously saved .json point list from disk"/>
                        <TextBlock Grid.Column="1" Text="Import a previously saved point list (.json)"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,4,0,0" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Use generated points"
                                Command="{Binding UseGeneratedCommand}" Padding="8,2"
                                ToolTip="Use the point list currently shown in the OnStepX Model Builder panel"/>
                        <TextBlock Grid.Column="1" Text="Copy points from the Model Builder panel"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,4,0,0" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="{Binding Points.Count, StringFormat='{}{0} point(s) loaded'}"
                               Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>

                    <TextBlock Text="Exposure time is taken from the plate-solve settings in the NINA profile."
                               Foreground="Gray" FontSize="10" FontStyle="Italic" Margin="0,4,0,0"/>

                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!-- ── OnStepX Star Alignment ────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type seq:BuildStarAlignment}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6,4">

                    <!-- Options -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Save alignment to EEPROM on completion"
                                  IsChecked="{Binding SaveToEeprom}" VerticalAlignment="Top"
                                  ToolTip="Persist the alignment stars to non-volatile memory (:AW#) - they survive a power cycle"/>
                        <TextBlock Grid.Column="1"
                                   Text="Persist alignment stars to non-volatile memory - survives power cycles"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,2,0,0" VerticalAlignment="Top" TextWrapping="Wrap"/>
                    </Grid>

                    <Separator Margin="0,0,0,8"/>

                    <!-- Point source -->
                    <TextBlock Text="Alignment star source  (1–9 stars; controller solves on-device):"
                               FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Load from file…"
                                Command="{Binding LoadPointsCommand}" Padding="8,2"
                                ToolTip="Load a previously saved .json point list from disk"/>
                        <TextBlock Grid.Column="1" Text="Import a previously saved point list (.json)"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,4,0,0" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Use generated points"
                                Command="{Binding UseGeneratedCommand}" Padding="8,2"
                                ToolTip="Use the point list from the OnStepX Model Builder panel (Star Alignment mode, max 9)"/>
                        <TextBlock Grid.Column="1" Text="Copy points from the Model Builder panel"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,4,0,0" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="{Binding Points.Count, StringFormat='{}{0} star(s) loaded'}"
                               Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>

                    <TextBlock Text="Exposure time is taken from the plate-solve settings in the NINA profile."
                               Foreground="Gray" FontSize="10" FontStyle="Italic" Margin="0,4,0,0"/>

                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!-- ── Apply Model from File ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type seq:ApplyModelFromFile}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6,4">

                    <!-- File path -->
                    <TextBlock Text="Model file (.json):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ModelFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Courier New" FontSize="11"
                                 ToolTip="Path to a JSON file containing AlignmentModelCoefficients"/>
                        <Button Grid.Column="1" Content="Browse…"
                                Command="{Binding BrowseFileCommand}"
                                Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Open a file picker to select the coefficient JSON file"/>
                    </Grid>

                    <!-- EEPROM option -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Save to EEPROM after writing"
                                  IsChecked="{Binding SaveToEeprom}" VerticalAlignment="Top"
                                  ToolTip="After uploading the coefficients (:SX0n,v#), also send :AW# to persist the model across power cycles"/>
                        <TextBlock Grid.Column="1"
                                   Text="Persist the model to non-volatile memory - survives power cycles"
                                   Foreground="Gray" FontSize="10" FontStyle="Italic"
                                   Margin="8,2,0,0" VerticalAlignment="Top" TextWrapping="Wrap"/>
                    </Grid>

                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!-- ── Clear Alignment Model ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type seq:ClearAlignmentModel}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <TextBlock Margin="6,4"
                           Text="Erase the pointing model from controller RAM. Does not affect EEPROM."
                           Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"/>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!-- ── Save Alignment to EEPROM ──────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type seq:WriteAlignmentToNv}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <TextBlock Margin="6,4"
                           Text="Persist the current alignment model to non-volatile memory. The model will survive a power cycle."
                           Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"/>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

</ResourceDictionary>
